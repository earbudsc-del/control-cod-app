NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto para llamadas de cron job al endpoint de auto-tracking
# POST /api/tracking/auto con header: x-cron-secret: <valor>
CRON_SECRET=

# Webhook Shopify: secret para verificar HMAC de orders/create
# Shopify Partners → App → Webhooks → signing secret
SHOPIFY_WEBHOOK_SECRET=

# Shopify Admin API: para recuperación de pedidos perdidos
# SHOPIFY_SHOP_DOMAIN: dominio .myshopify.com (ej. mi-tienda.myshopify.com)
# SHOPIFY_ADMIN_ACCESS_TOKEN: token con scope read_orders
#   Shopify Admin → Settings → Apps → Develop apps → tu-app → Admin API access token
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Ruta COD (app de mensajero, proyecto Vite separado): origen permitido para
# el CORS de GET /api/v1/deliveries/orders. Acepta varios orígenes separados
# por coma. En desarrollo normalmente es el puerto de Vite.
RUTA_COD_ALLOWED_ORIGIN=http://localhost:5173

# URL pública de Control COD (sin slash final). Se usa para construir el link
# al Inbox interno (/inbox?conversation=...) que la API de deliveries/orders
# devuelve al mensajero cuando ya existe una conversación de WhatsApp. Si no
# se define, el endpoint cae automáticamente al fallback wa.me.
NEXT_PUBLIC_APP_URL=http://localhost:3000
